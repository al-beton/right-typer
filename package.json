{
  "name": "right-typer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "pnpm assets && pnpm worker && vite --host 127.0.0.1",
    "build": "pnpm assets && pnpm worker && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "worker": "vite build --config vite.worker.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sample": "vite build --config vite.sample.config.ts && node .sample-cli/sample.mjs",
    "lint": "eslint . --max-warnings 0",
    "dataset": "vite build --config vite.sample.config.ts && python3 scripts/dataset/library.py",
    "test:dataset": "python3 -m unittest discover -s scripts/dataset -p 'test_*.py'"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.1",
    "agent-browser": "0.21.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
